# Betting Framework - Complete Production Environment Template
# Copy to .env and fill in actual values
# Last updated: 2026-06-28

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

DEBUG=False
APP_NAME=Edge AI - Unified Betting Platform

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================

DATABASE_URL=postgresql://betting_user:STRONG_PASSWORD_HERE@localhost:5432/betting_db
POSTGRES_USER=betting_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=betting_db
POSTGRES_PORT=5432

# ============================================================================
# CACHE (Redis)
# ============================================================================

REDIS_URL=redis://:REDIS_PASSWORD_HERE@localhost:6379
REDIS_PASSWORD=REDIS_PASSWORD_HERE
REDIS_PORT=6379

# ============================================================================
# SECURITY & JWT
# ============================================================================

SECRET_KEY=VERY_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS_CHANGE_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# RISK MANAGEMENT
# ============================================================================

MAX_SINGLE_BET_FRACTION=0.05          # Max bet is 5% of bankroll
MAX_DAILY_LOSS_FRACTION=0.10          # Max daily loss is 10%
MAX_KELLY_FRACTION=0.25               # Max Kelly bet is 25% of calculated
MIN_KELLY_FRACTION=0.01               # Min Kelly bet is 1%

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

VITE_API_URL=https://api.edge-ai.io
VITE_APP_NAME=Edge AI

# ============================================================================
# SPORTS BETTING APIs
# ============================================================================

# Polymarket - Prediction Markets
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_BASE_URL=https://clob.polymarket.com

# DraftKings - Sports Betting Operator
DRAFTKINGS_API_KEY=your_draftkings_api_key_here
DRAFTKINGS_BASE_URL=https://api.draftkings.com

# BetMGM - Sports Betting Operator
BETMGM_API_KEY=your_betmgm_api_key_here
BETMGM_BASE_URL=https://api.betmgm.com

# Pinnacle - International Sports Book (MLB, Tennis, Cricket, Horse, Hockey)
PINNACLE_API_KEY=your_pinnacle_api_key_here
PINNACLE_BASE_URL=https://api.pinnacle.com

# ESPN - Sports Data
ESPN_API_KEY=your_espn_api_key_here

# StatsBomb/Baseball Savant - MLB Data
STATSBOMB_API_KEY=your_statsbomb_api_key_here
MLB_SAVANT_API_KEY=your_mlb_savant_api_key_here

# Tennis Data Providers
ATP_API_KEY=your_atp_api_key_here
WTA_API_KEY=your_wta_api_key_here
TENNIS_EXPLORER_API_KEY=your_tennis_explorer_api_key_here

# Cricket Data
ESPN_CRICKET_API_KEY=your_espn_cricket_api_key_here
CRICKETDATA_IO_API_KEY=your_cricketdata_io_api_key_here

# Horse Racing Data
EQUIBASE_API_KEY=your_equibase_api_key_here
HKJC_API_KEY=your_hkjc_api_key_here

# Hockey Data (NHL)
NHL_API_KEY=your_nhl_api_key_here
NHL_STATS_API_URL=https://statsapi.web.nhl.com

# ============================================================================
# ECONOMIC DATA APIs
# ============================================================================

# Federal Reserve Economic Data (FRED)
FRED_API_KEY=your_fred_api_key_here
FRED_BASE_URL=https://api.stlouisfed.org

# Yahoo Finance
YAHOO_FINANCE_API_KEY=your_yahoo_finance_api_key_here

# Alpha Vantage - Stock Data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# IEX Cloud - Market Data
IEX_CLOUD_API_KEY=your_iex_cloud_api_key_here

# ============================================================================
# CRYPTOCURRENCY & BLOCKCHAIN APIs
# ============================================================================

# CoinGecko - Crypto Prices (no key required for basic access)
COINGECKO_API_KEY=your_coingecko_api_key_here
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Binance - Crypto Exchange
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Kraken - Crypto Exchange
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# ============================================================================
# NEWS & SENTIMENT APIs
# ============================================================================

# NewsAPI - Sports and Market News
NEWSAPI_API_KEY=your_newsapi_api_key_here

# Twitter/X API - Sentiment Analysis
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here

# ============================================================================
# DEPLOYMENT & CLOUD PLATFORMS
# ============================================================================

# Railway Deployment
RAILWAY_API_TOKEN=your_railway_api_token_here
RAILWAY_PROJECT_ID=your_railway_project_id_here

# Vercel Deployment (Frontend)
VERCEL_TOKEN=your_vercel_token_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# AWS (for S3, CloudFront, Lambda, etc.)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=betting-framework-data

# GCP (if used)
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_CREDENTIALS_FILE=/path/to/credentials.json

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Sentry - Error Tracking
SENTRY_DSN=https://your-sentry-url@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# Datadog - Monitoring & APM
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here
DATADOG_ENV=production

# LogRocket - Frontend Error Tracking
LOGROCKET_APP_ID=your_logrocket_app_id_here

# ============================================================================
# EMAIL & NOTIFICATIONS
# ============================================================================

# SendGrid - Email Service
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@edge-ai.io

# Twilio - SMS Notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# ============================================================================
# DOMAIN & SSL
# ============================================================================

DOMAIN=edge-ai.io
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# ============================================================================
# INTERNAL SETTINGS (Development/Testing)
# ============================================================================

# Test Mode
TEST_MODE=False
TEST_API_KEY=test_key_for_development_only

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/betting_framework.log

# Feature Flags
ENABLE_LIVE_TRADING=True
ENABLE_BACKTESTING=True
ENABLE_PAPER_TRADING=True
ENABLE_SIMULATION=True
