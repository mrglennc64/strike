[Unit]
Description=Strike Frontend Web Service
Documentation=https://github.com/mrglennc64/strike
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=strike
Group=strike
WorkingDirectory=/opt/strike/frontend
Environment="NODE_ENV=production"
EnvironmentFile=-/etc/strike/frontend.env

# Node.js application
ExecStart=/usr/bin/node /opt/strike/frontend/server.js

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=120
StartLimitBurst=3

# Resource limits
MemoryLimit=512M
CPUQuota=50%
LimitNOFILE=65535

# Security
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=strike-frontend

# Health check
ExecStartPost=/usr/bin/curl -f http://localhost:3000/ || /bin/true

# Timeout for shutdown
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
