# Federal Reserve Economic Data (FRED) API Configuration

# FRED API Key (get free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Polymarket API (optional, for market price integration)
# POLYMARKET_API_KEY=your_polymarket_api_key_here
# POLYMARKET_API_URL=https://api.polymarket.com

# Kalshi API (optional, for market price integration)
# KALSHI_API_KEY=your_kalshi_api_key_here
# KALSHI_API_SECRET=your_kalshi_api_secret_here
# KALSHI_API_URL=https://api.kalshi.com

# Model Training Configuration
MODEL_TRAIN_AUTO=false          # Auto-train models on schedule
MODEL_TRAIN_FREQUENCY_HOURS=24  # Train every N hours
MODEL_MAX_HISTORY_YEARS=10      # Max historical data to use
MODEL_TEST_SPLIT=0.2            # Train/test split ratio

# Edge Detection Configuration
MIN_EDGE_PERCENTAGE=0.05        # Minimum edge to report (5%)
KELLY_FRACTION_CAP=0.25         # Max Kelly fraction for safety
MIN_MARKET_LIQUIDITY=1000       # Minimum market volume to consider

# Thresholds for Predictions
CPI_THRESHOLD=3.5               # CPI > 3.5% prediction
UNEMPLOYMENT_THRESHOLD=4.2      # Unemployment > 4.2% prediction
GDP_THRESHOLD=2.5               # GDP > 2.5% annualized prediction

# Calendar Update Frequency
FOMC_CALENDAR_REFRESH_HOURS=24  # Refresh FOMC schedule daily
ECONOMIC_CALENDAR_REFRESH_HOURS=6  # Refresh economic calendar every 6 hours

# Database
# Already configured in main .env file

# Logging
ECONOMICS_LOG_LEVEL=INFO
ECONOMICS_LOG_FILE=/var/log/economics_predictor.log
