# ============================================================================
# Betting Framework Backend - Production Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual production values
# NEVER commit .env with real secrets to version control
# ============================================================================

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4
APP_NAME=Betting Framework API - Production

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://betting_user:secure_password_here@db.example.com:5432/betting_db
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600

# ============================================================================
# Authentication & Security
# ============================================================================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-very-secure-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Risk Management
# ============================================================================
MAX_SINGLE_BET_FRACTION=0.05
MAX_DAILY_LOSS_FRACTION=0.10
MAX_KELLY_FRACTION=0.25
MIN_KELLY_FRACTION=0.01
MAX_CONCURRENT_BETS=50

# ============================================================================
# External APIs - Odds & Markets
# ============================================================================
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_TIMEOUT=30

# ============================================================================
# Prediction Markets
# ============================================================================
POLYMARKET_KEY=your_polymarket_api_key
POLYMARKET_SECRET=your_polymarket_secret
KALSHI_API_KEY=your_kalshi_api_key
KALSHI_API_SECRET=your_kalshi_api_secret

# ============================================================================
# Data Sources
# ============================================================================
STATCAST_API_KEY=your_statcast_key
FRED_API_KEY=your_fred_api_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
FINNHUB_API_KEY=your_finnhub_api_key

# ============================================================================
# Middleware Configuration
# ============================================================================
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=100
CORS_ORIGINS=https://app.example.com,https://api.example.com

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/betting_framework/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUPS=10

# ============================================================================
# Cache Configuration
# ============================================================================
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://:password@redis.example.com:6379/0

# ============================================================================
# Model Configuration
# ============================================================================
MLB_MODEL_PATH=/models/mlb_strikeout_model.pkl
ECONOMICS_MODEL_PATH=/models/economics_model.pkl
EARNINGS_MODEL_PATH=/models/earnings_model.pkl

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_MLB_EDGE=true
ENABLE_TENNIS_EDGE=true
ENABLE_CRICKET_EDGE=true
ENABLE_HORSE_EDGE=true
ENABLE_HOCKEY_EDGE=true
ENABLE_ECONOMICS_EDGE=true
ENABLE_EARNINGS_EDGE=true

# ============================================================================
# Monitoring & Observability
# ============================================================================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
ENABLE_METRICS=true
METRICS_PORT=8001

# ============================================================================
# Email Configuration (for alerts)
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=alerts@example.com
