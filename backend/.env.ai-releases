# AI Releases Predictor Configuration

# GitHub API
# Get token at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Polymarket API
# Register at: https://www.polymarket.com/api
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com

# Model paths
MODEL_CHECKPOINT_PATH=./models/release_predictor.pkl
SCALER_CHECKPOINT_PATH=./models/scaler.pkl

# Prediction cache (in minutes)
PREDICTION_CACHE_TTL=30

# Rate limiting
GITHUB_RATE_LIMIT_DELAY=1
POLYMARKET_RATE_LIMIT_DELAY=2

# Feature flags
ENABLE_SENTIMENT_ANALYSIS=false
ENABLE_SOCIAL_SIGNALS=false
ENABLE_LEAK_DETECTION=false

# Prediction thresholds
MIN_CONFIDENCE_FOR_RECOMMENDATION=0.60
MIN_EDGE_FOR_TRADING=0.05

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ai_releases.log
